<!DOCTYPE html>
<html lang="pt-BR">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0, maximum-scale=1.0, user-scalable=no" />
  <title>Calculadora Científica</title>
  <!-- Carregamento do Tailwind CSS para estilização responsiva -->
  <script src="https://cdn.tailwindcss.com"></script>
  <!-- Fonte Inter do Google Fonts -->
  <link rel="preconnect" href="https://fonts.googleapis.com" />
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
  <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&display=swap" rel="stylesheet" />
  <script>
    tailwind.config = {
      theme: {
        extend: {
          fontFamily: {
            sans: ['Inter', 'system-ui', '-apple-system', 'sans-serif'],
          },
        },
      },
    };
  </script>
</head>
<body class="bg-[#0f172a] text-[#f8fafc] font-sans min-h-[100dvh] flex items-center justify-center p-4 antialiased selection:bg-sky-500/30">

  <!-- Cartão principal centralizado da Calculadora Científica -->
  <main class="w-full max-w-[400px] bg-[#1e293b] border border-[#334155] rounded-2xl p-5 shadow-2xl">
    
    <!-- Cabeçalho superior com título e alternador DEG / RAD -->
    <header class="flex items-center justify-between mb-4">
      <h1 class="text-sm sm:text-base font-semibold text-slate-300 tracking-wide">
        Calculadora Científica
      </h1>
      <button
        id="btn-modo"
        type="button"
        title="Alternar entre Graus (DEG) e Radianos (RAD)"
        class="bg-[#0f172a] text-sky-400 border border-[#334155] hover:border-sky-400 active:scale-95 rounded-lg px-3 py-1.5 text-xs font-bold tracking-wider transition-all touch-manipulation select-none"
      >
        DEG
      </button>
    </header>

    <!-- Visor dividido em duas linhas: histórico superior e expressão/resultado principal -->
    <section
      aria-live="polite"
      class="bg-[#0f172a] border border-[#334155] rounded-xl p-4 mb-4 min-h-[104px] flex flex-col justify-between text-right overflow-hidden"
    >
      <div
        id="historico"
        class="text-xs sm:text-sm text-[#64748b] min-h-[20px] truncate"
      ></div>
      <div
        id="visor-principal"
        class="text-2xl sm:text-3xl font-bold text-[#f8fafc] mt-2 break-all leading-tight"
      >0</div>
    </section>

    <!-- Teclado em grade de 5 colunas otimizado para toque e desktop -->
    <section class="grid grid-cols-5 gap-2" aria-label="Teclado da calculadora">
      
      <!-- Linha 1: Funções trigonométricas e logarítmicas -->
      <button type="button" data-valor="sin(" class="tecla h-12 rounded-xl bg-[#273549] hover:bg-[#334155] text-slate-200 text-xs sm:text-sm font-semibold active:scale-95 transition-all touch-manipulation select-none">sin</button>
      <button type="button" data-valor="cos(" class="tecla h-12 rounded-xl bg-[#273549] hover:bg-[#334155] text-slate-200 text-xs sm:text-sm font-semibold active:scale-95 transition-all touch-manipulation select-none">cos</button>
      <button type="button" data-valor="tan(" class="tecla h-12 rounded-xl bg-[#273549] hover:bg-[#334155] text-slate-200 text-xs sm:text-sm font-semibold active:scale-95 transition-all touch-manipulation select-none">tan</button>
      <button type="button" data-valor="log(" class="tecla h-12 rounded-xl bg-[#273549] hover:bg-[#334155] text-slate-200 text-xs sm:text-sm font-semibold active:scale-95 transition-all touch-manipulation select-none">log</button>
      <button type="button" data-valor="ln("  class="tecla h-12 rounded-xl bg-[#273549] hover:bg-[#334155] text-slate-200 text-xs sm:text-sm font-semibold active:scale-95 transition-all touch-manipulation select-none">ln</button>

      <!-- Linha 2: Raiz, potências e constantes -->
      <button type="button" data-valor="√("  class="tecla h-12 rounded-xl bg-[#273549] hover:bg-[#334155] text-slate-200 text-sm font-semibold active:scale-95 transition-all touch-manipulation select-none">√</button>
      <button type="button" data-valor="^"   class="tecla h-12 rounded-xl bg-[#273549] hover:bg-[#334155] text-slate-200 text-xs sm:text-sm font-semibold active:scale-95 transition-all touch-manipulation select-none">xʸ</button>
      <button type="button" data-valor="^2"  class="tecla h-12 rounded-xl bg-[#273549] hover:bg-[#334155] text-slate-200 text-xs sm:text-sm font-semibold active:scale-95 transition-all touch-manipulation select-none">x²</button>
      <button type="button" data-valor="π"   class="tecla h-12 rounded-xl bg-[#273549] hover:bg-[#334155] text-slate-200 text-sm font-semibold active:scale-95 transition-all touch-manipulation select-none">π</button>
      <button type="button" data-valor="e"   class="tecla h-12 rounded-xl bg-[#273549] hover:bg-[#334155] text-slate-200 text-sm font-semibold active:scale-95 transition-all touch-manipulation select-none">e</button>

      <!-- Linha 3: Parênteses, fatorial e controles de limpeza -->
      <button type="button" data-valor="("   class="tecla h-12 rounded-xl bg-[#273549] hover:bg-[#334155] text-slate-200 text-sm font-semibold active:scale-95 transition-all touch-manipulation select-none">(</button>
      <button type="button" data-valor=")"   class="tecla h-12 rounded-xl bg-[#273549] hover:bg-[#334155] text-slate-200 text-sm font-semibold active:scale-95 transition-all touch-manipulation select-none">)</button>
      <button type="button" data-valor="!"   class="tecla h-12 rounded-xl bg-[#273549] hover:bg-[#334155] text-slate-200 text-xs sm:text-sm font-semibold active:scale-95 transition-all touch-manipulation select-none">n!</button>
      <button type="button" data-acao="apagar" class="tecla h-12 rounded-xl bg-red-950/90 hover:bg-red-900 border border-red-900/60 text-red-200 text-xs sm:text-sm font-bold active:scale-95 transition-all touch-manipulation select-none">DEL</button>
      <button type="button" data-acao="limpar" class="tecla h-12 rounded-xl bg-red-950/90 hover:bg-red-900 border border-red-900/60 text-red-200 text-xs sm:text-sm font-bold active:scale-95 transition-all touch-manipulation select-none">AC</button>

      <!-- Linha 4 -->
      <button type="button" data-valor="7"   class="tecla h-12 rounded-xl bg-[#0f172a] hover:bg-slate-900 border border-slate-800/80 text-[#f8fafc] text-lg font-semibold active:scale-95 transition-all touch-manipulation select-none">7</button>
      <button type="button" data-valor="8"   class="tecla h-12 rounded-xl bg-[#0f172a] hover:bg-slate-900 border border-slate-800/80 text-[#f8fafc] text-lg font-semibold active:scale-95 transition-all touch-manipulation select-none">8</button>
      <button type="button" data-valor="9"   class="tecla h-12 rounded-xl bg-[#0f172a] hover:bg-slate-900 border border-slate-800/80 text-[#f8fafc] text-lg font-semibold active:scale-95 transition-all touch-manipulation select-none">9</button>
      <button type="button" data-valor="%"   class="tecla h-12 rounded-xl bg-[#273549] hover:bg-[#334155] text-slate-200 text-sm font-semibold active:scale-95 transition-all touch-manipulation select-none">%</button>
      <button type="button" data-valor="÷"   class="tecla h-12 rounded-xl bg-blue-700 hover:bg-blue-600 text-white text-xl font-semibold active:scale-95 transition-all touch-manipulation select-none">÷</button>

      <!-- Linha 5 -->
      <button type="button" data-valor="4"   class="tecla h-12 rounded-xl bg-[#0f172a] hover:bg-slate-900 border border-slate-800/80 text-[#f8fafc] text-lg font-semibold active:scale-95 transition-all touch-manipulation select-none">4</button>
      <button type="button" data-valor="5"   class="tecla h-12 rounded-xl bg-[#0f172a] hover:bg-slate-900 border border-slate-800/80 text-[#f8fafc] text-lg font-semibold active:scale-95 transition-all touch-manipulation select-none">5</button>
      <button type="button" data-valor="6"   class="tecla h-12 rounded-xl bg-[#0f172a] hover:bg-slate-900 border border-slate-800/80 text-[#f8fafc] text-lg font-semibold active:scale-95 transition-all touch-manipulation select-none">6</button>
      <button type="button" data-valor="×"   class="tecla h-12 rounded-xl bg-blue-700 hover:bg-blue-600 text-white text-xl font-semibold active:scale-95 transition-all touch-manipulation select-none">×</button>
      <button type="button" data-valor="−"   class="tecla h-12 rounded-xl bg-blue-700 hover:bg-blue-600 text-white text-xl font-semibold active:scale-95 transition-all touch-manipulation select-none">−</button>

      <!-- Linha 6 -->
      <button type="button" data-valor="1"   class="tecla h-12 rounded-xl bg-[#0f172a] hover:bg-slate-900 border border-slate-800/80 text-[#f8fafc] text-lg font-semibold active:scale-95 transition-all touch-manipulation select-none">1</button>
      <button type="button" data-valor="2"   class="tecla h-12 rounded-xl bg-[#0f172a] hover:bg-slate-900 border border-slate-800/80 text-[#f8fafc] text-lg font-semibold active:scale-95 transition-all touch-manipulation select-none">2</button>
      <button type="button" data-valor="3"   class="tecla h-12 rounded-xl bg-[#0f172a] hover:bg-slate-900 border border-slate-800/80 text-[#f8fafc] text-lg font-semibold active:scale-95 transition-all touch-manipulation select-none">3</button>
      <button type="button" data-valor="0"   class="tecla h-12 rounded-xl bg-[#0f172a] hover:bg-slate-900 border border-slate-800/80 text-[#f8fafc] text-lg font-semibold active:scale-95 transition-all touch-manipulation select-none">0</button>
      <button type="button" data-valor="+"   class="tecla h-12 rounded-xl bg-blue-700 hover:bg-blue-600 text-white text-xl font-semibold active:scale-95 transition-all touch-manipulation select-none">+</button>

      <!-- Linha 7: Ponto decimal, inverso, troca de sinal e igual (2 colunas) -->
      <button type="button" data-valor="."   class="tecla h-12 rounded-xl bg-[#0f172a] hover:bg-slate-900 border border-slate-800/80 text-[#f8fafc] text-xl font-bold active:scale-95 transition-all touch-manipulation select-none">.</button>
      <button type="button" data-acao="inverso" class="tecla h-12 rounded-xl bg-[#273549] hover:bg-[#334155] text-slate-200 text-xs sm:text-sm font-semibold active:scale-95 transition-all touch-manipulation select-none">1/x</button>
      <button type="button" data-acao="sinal"   class="tecla h-12 rounded-xl bg-[#273549] hover:bg-[#334155] text-slate-200 text-xs sm:text-sm font-semibold active:scale-95 transition-all touch-manipulation select-none">+/−</button>
      <button type="button" data-acao="calcular" class="tecla col-span-2 h-12 rounded-xl bg-[#059669] hover:bg-[#10b981] text-white text-2xl font-bold shadow-lg shadow-emerald-950/40 active:scale-95 transition-all touch-manipulation select-none">=</button>

    </section>
  </main>

  <script>
    // Referências aos elementos da interface
    const visorPrincipal = document.getElementById("visor-principal");
    const historico = document.getElementById("historico");
    const btnModo = document.getElementById("btn-modo");
    const teclas = document.querySelectorAll(".tecla");

    // Estado interno da calculadora
    let expressaoAtual = "";
    let modoGraus = true; // true = DEG (Graus), false = RAD (Radianos)
    let acabouDeCalcular = false;

    /**
     * Alterna entre os modos angulares Graus (DEG) e Radianos (RAD).
     */
    btnModo.addEventListener("click", () => {
      modoGraus = !modoGraus;
      btnModo.textContent = modoGraus ? "DEG" : "RAD";
    });

    /**
     * Calcula o fatorial de um número inteiro não negativo.
     * Retorna NaN para negativos ou decimais e Infinity se exceder o limite seguro.
     */
    function fatorial(n) {
      if (typeof n !== "number" || isNaN(n) || !isFinite(n) || n < 0 || !Number.isInteger(n)) {
        return NaN;
      }
      if (n > 170) {
        return Infinity;
      }
      if (n === 0 || n === 1) {
        return 1;
      }
      let resultado = 1;
      for (let i = 2; i <= n; i++) {
        resultado *= i;
      }
      return resultado;
    }

    /**
     * Calcula o seno respeitando o modo DEG ou RAD e corrigindo ruído decimal próximo de zero.
     */
    function seno(x) {
      const rad = modoGraus ? (x * Math.PI) / 180 : x;
      const res = Math.sin(rad);
      return Math.abs(res) < 1e-12 ? 0 : res;
    }

    /**
     * Calcula o cosseno respeitando o modo DEG ou RAD e corrigindo ruído decimal próximo de zero.
     */
    function cosseno(x) {
      const rad = modoGraus ? (x * Math.PI) / 180 : x;
      const res = Math.cos(rad);
      return Math.abs(res) < 1e-12 ? 0 : res;
    }

    /**
     * Calcula a tangente respeitando o modo DEG ou RAD.
     * Retorna NaN para ângulos indefinidos como 90°, 270°, etc., no modo DEG.
     */
    function tangente(x) {
      if (modoGraus && Math.abs(x % 180) === 90) {
        return NaN;
      }
      const rad = modoGraus ? (x * Math.PI) / 180 : x;
      const res = Math.tan(rad);
      return Math.abs(res) < 1e-12 ? 0 : res;
    }

    /**
     * Atualiza o texto exibido no visor principal.
     */
    function atualizarVisor() {
      visorPrincipal.textContent = expressaoAtual === "" ? "0" : expressaoAtual;
    }

    /**
     * Insere um número, operador, constante ou função na expressão atual.
     */
    function inserirValor(valor) {
      const operadores = ["+", "−", "-", "×", "÷", "^", "^2", "%", "!"];

      if (acabouDeCalcular) {
        if (operadores.includes(valor)) {
          acabouDeCalcular = false;
        } else {
          expressaoAtual = "";
          acabouDeCalcular = false;
        }
      }

      if (expressaoAtual === "Erro") {
        expressaoAtual = "";
      }

      expressaoAtual += valor;
      atualizarVisor();
    }

    /**
     * Limpa completamente o visor e o histórico (tecla AC).
     */
    function limparTudo() {
      expressaoAtual = "";
      historico.textContent = "";
      acabouDeCalcular = false;
      atualizarVisor();
    }

    /**
     * Apaga o último token de função (ex: "sin(") ou o último caractere digitado (tecla DEL).
     */
    function apagarUltimo() {
      if (expressaoAtual === "Erro" || acabouDeCalcular) {
        limparTudo();
        return;
      }

      const funcoes = ["sin(", "cos(", "tan(", "log(", "ln(", "√("];
      for (const fn of funcoes) {
        if (expressaoAtual.endsWith(fn)) {
          expressaoAtual = expressaoAtual.slice(0, -fn.length);
          atualizarVisor();
          return;
        }
      }

      expressaoAtual = expressaoAtual.slice(0, -1);
      atualizarVisor();
    }

    /**
     * Inverte o sinal da expressão ou número atual (tecla +/−).
     */
    function alternarSinal() {
      if (expressaoAtual === "" || expressaoAtual === "0" || expressaoAtual === "Erro") {
        return;
      }

      acabouDeCalcular = false;

      if (expressaoAtual.startsWith("-(") && expressaoAtual.endsWith(")")) {
        expressaoAtual = expressaoAtual.slice(2, -1);
      } else if (/^-\d+(\.\d+)?$/.test(expressaoAtual)) {
        expressaoAtual = expressaoAtual.slice(1);
      } else if (/^\d+(\.\d+)?$/.test(expressaoAtual)) {
        expressaoAtual = "-" + expressaoAtual;
      } else if (expressaoAtual.startsWith("-")) {
        expressaoAtual = expressaoAtual.slice(1);
      } else {
        expressaoAtual = "-(" + expressaoAtual + ")";
      }

      atualizarVisor();
    }

    /**
     * Converte a expressão visual para código JavaScript válido, avalia o resultado
     * e trata erros ou imprecisões de ponto flutuante.
     */
    function calcularResultado() {
      if (expressaoAtual === "" || expressaoAtual === "Erro") {
        return;
      }

      try {
        let formula = expressaoAtual;

        // 1. Fecha automaticamente parênteses abertos esquecidos
        const abertos = (formula.match(/\(/g) || []).length;
        const fechados = (formula.match(/\)/g) || []).length;
        if (abertos > fechados) {
          formula += ")".repeat(abertos - fechados);
        }

        // 2. Insere multiplicação implícita (ex: 2π, 2(3+4), (2+1)(3+4), 2sin(30))
        formula = formula
          .replace(/(\d|\)|π|e|!)(?=(π|e|\(|sin\(|cos\(|tan\(|log\(|ln\(|√\())/g, "$1*")
          .replace(/(\)|π|e|!)(?=(\d))/g, "$1*");

        // 3. Substitui constantes π e e antes de expandir nomes de funções
        formula = formula
          .replace(/π/g, "Math.PI")
          .replace(/(?<![0-9a-zA-Z_])e(?![0-9a-zA-Z_])/g, "Math.E");

        // 4. Converte operadores visuais e funções científicas para JavaScript
        formula = formula
          .replace(/−/g, "-")
          .replace(/×/g, "*")
          .replace(/÷/g, "/")
          .replace(/\^/g, "**")
          .replace(/%/g, "/100")
          .replace(/√\(/g, "Math.sqrt(")
          .replace(/sin\(/g, "seno(")
          .replace(/cos\(/g, "cosseno(")
          .replace(/tan\(/g, "tangente(")
          .replace(/log\(/g, "Math.log10(")
          .replace(/ln\(/g, "Math.log(");

        // 5. Converte fatoriais numéricos (ex: 5!) e entre parênteses (ex: (2+3)!)
        formula = formula.replace(/(\d+(?:\.\d+)?)!/g, "fatorial($1)");
        while (/\(([^()]+)\)!/.test(formula)) {
          formula = formula.replace(/\(([^()]+)\)!/g, "fatorial($1)");
        }

        // 6. Avalia a expressão de forma segura e isolada
        const avaliar = new Function(
          "seno",
          "cosseno",
          "tangente",
          "fatorial",
          `"use strict"; return (${formula});`
        );
        const resultadoBruto = avaliar(seno, cosseno, tangente, fatorial);

        // 7. Valida resultado finito e corrige imprecisões de ponto flutuante (ex: sin(30) = 0.5)
        if (typeof resultadoBruto !== "number" || !isFinite(resultadoBruto) || isNaN(resultadoBruto)) {
          historico.textContent = `${expressaoAtual} =`;
          expressaoAtual = "Erro";
        } else {
          const valorLimpo = Math.abs(resultadoBruto) < 1e-12 ? 0 : resultadoBruto;
          const resultadoFormatado = Number(valorLimpo.toPrecision(12)).toString();
          historico.textContent = `${expressaoAtual} =`;
          expressaoAtual = resultadoFormatado;
        }

        acabouDeCalcular = true;
        atualizarVisor();
      } catch (erro) {
        historico.textContent = `${expressaoAtual} =`;
        expressaoAtual = "Erro";
        acabouDeCalcular = true;
        atualizarVisor();
      }
    }

    // Mapeia cliques e toques nos botões do teclado na tela
    teclas.forEach((tecla) => {
      tecla.addEventListener("click", () => {
        const valor = tecla.getAttribute("data-valor");
        const acao = tecla.getAttribute("data-acao");

        if (valor) {
          inserirValor(valor);
        } else if (acao === "limpar") {
          limparTudo();
        } else if (acao === "apagar") {
          apagarUltimo();
        } else if (acao === "calcular") {
          calcularResultado();
        } else if (acao === "sinal") {
          alternarSinal();
        } else if (acao === "inverso") {
          if (expressaoAtual !== "" && expressaoAtual !== "Erro") {
            expressaoAtual = `1÷(${expressaoAtual})`;
            calcularResultado();
          }
        }
      });
    });

    // Suporte completo a teclado físico no computador
    document.addEventListener("keydown", (evento) => {
      const tecla = evento.key;

      if ((tecla >= "0" && tecla <= "9") || [".", "(", ")", "^", "%", "!"].includes(tecla)) {
        inserirValor(tecla);
      } else if (tecla === "+") {
        inserirValor("+");
      } else if (tecla === "-") {
        inserirValor("−");
      } else if (tecla === "*") {
        inserirValor("×");
      } else if (tecla === "/") {
        evento.preventDefault();
        inserirValor("÷");
      } else if (tecla === "Enter" || tecla === "=") {
        evento.preventDefault();
        calcularResultado();
      } else if (tecla === "Backspace") {
        evento.preventDefault();
        apagarUltimo();
      } else if (tecla === "Escape" || tecla === "Delete") {
        evento.preventDefault();
        limparTudo();
      }
    });
  </script>
</body>
</html>
